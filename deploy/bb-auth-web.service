[Unit]
Description=bb-auth-web (access-file admin GUI, behind bb-auth's own auth_request)
Documentation=file:/opt/bb-auth/bin/bb-auth-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bb-auth-web
Group=bb-auth-web
# Membership in the GATE's group, and it is load-bearing twice over. The access file is
# bb-auth-web:bb-auth 0640, so the gate reads it through this group; and the library's
# writer chowns its temp file back to the replaced file's uid:gid before renaming it into
# place — an unprivileged process may only chgrp to a group it is a member of, so without
# this every save would abort with EPERM and nothing would ever be written.
SupplementaryGroups=bb-auth
EnvironmentFile=/opt/bb-auth/etc/bb-auth-web.env
ExecStart=/opt/bb-auth/bin/bb-auth-web
# No ExecReload: there is no table to reload. The access file is read fresh on every
# request, and the config is read once at startup like the gate's — an env edit is a
# `systemctl restart bb-auth-web`. What DOES need a signal is the gate, after this
# service rewrites the file; bb-auth-reload.path is what sends it.
Restart=on-failure
RestartSec=2

# --- Hardening ---
# Mirrors bb-auth.service, with two deliberate differences: this one writes (see
# ReadWritePaths below), and it makes one outbound call: the profile edit on `/account`
# reaches Cognito, so the egress the gate has, this one has too (docs/ARCHITECTURE.md
# §13.22). That is what the removed IP filter below is about.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
# bind 127.0.0.1:8091; AF_NETLINK/AF_UNIX for the resolver, in case BB_AUTH_WEB_LISTEN
# is written as a name rather than a literal address. AF_INET/AF_INET6 are also the family
# of the outbound call the profile edit makes.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# The kernel's loopback lock on the listener (`IPAddressDeny=any` +
# `IPAddressAllow=localhost`) is GONE, and the profile edit is why: those cgroup filters apply
# to outbound traffic as well, so the pair dropped every packet the call to Cognito sends
# (docs/ARCHITECTURE.md §13.7, §13.22). Against a caller on this host what replaces them is
# stronger than the filter was: the binary refuses a non-loopback bind unless
# BB_AUTH_WEB_ALLOW_NONLOOPBACK says otherwise, and every request, GET or POST, must carry the
# proxy secret. The cost is stated rather than glossed: on a stray non-loopback bind the
# secret is now the only lock, and the most privileged process on the host can open
# connections anywhere. An `IPAddressAllow=` of AWS's ranges was rejected: it takes static
# prefixes and AWS publishes a list that changes, so it would rot in this file.
# The same bounds the gate carries, and for the same reason.
TasksMax=256
MemoryMax=192M
# @system-service contains @chown (and copy_file_range/sendfile), which the writer needs:
# it copies the file one step back to access.json.bak, writes a temp file beside it,
# restores mode and owner, and renames. A narrower set would turn every save into an
# EPERM that looks exactly like a permissions bug.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
# ProtectSystem=strict already mounts the whole hierarchy read-only, so bin/ and etc/
# need no ReadOnlyPaths= line of their own — this is the one hole punched in it. It has
# to be the DIRECTORY, not the file: the write is a temp file created beside the access
# file and renamed onto it (that is what makes it atomic), plus the .bak copy, so both
# creating and renaming inside var/lib must be allowed.
ReadWritePaths=/opt/bb-auth/var/lib
# The HMAC key is in bb-auth.env, which is root:bb-auth 0640, and this unit is in group
# bb-auth for the access file, so the group bit hands the GUI the key that signs every
# session cookie and lets it mint a cookie for anybody. The directory and not the file: a
# per-file mount is lazily detached when a process outside the namespace renames onto it
# (Linux 3.18+), so an operator's `sed -i` on that env file would quietly give the key back.
# The EnvironmentFile= above still loads, because systemd reads env files on the manager's
# file system, before the sandbox is applied (systemd.exec(5)).
InaccessiblePaths=/opt/bb-auth/etc
UMask=0077

[Install]
WantedBy=multi-user.target
