#!/bin/sh
# bb-auth-web postrm. On purge it hands the access file back: installing this package
# is what moved it to bb-auth-web:bb-auth, so removing it is what must undo that, or
# the gate is left reading a file owned by a user nothing runs as.
set -e

DEST=/opt/bb-auth
VAR_DIR="$DEST/var/lib"
ACCESS_FILE="$VAR_DIR/access.json"
SETTINGS_FILE="$VAR_DIR/settings.json"

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

case "$1" in
remove)
    if [ -x /usr/bin/deb-systemd-helper ]; then
        for u in bb-auth-web.service bb-auth-reload.path bb-auth-reload.service; do
            deb-systemd-helper mask "$u" >/dev/null || true
        done
    fi
    ;;

purge)
    if [ -x /usr/bin/deb-systemd-helper ]; then
        for u in bb-auth-web.service bb-auth-reload.path bb-auth-reload.service; do
            deb-systemd-helper purge "$u" >/dev/null || true
            deb-systemd-helper unmask "$u" >/dev/null || true
        done
    fi

    rm -f "$DEST/etc/bb-auth-web.env"

    # Back to what a gate-only host looks like: the file root:bb-auth 0640, its
    # directory root:root 0755. Only while the gate's group still exists to own it;
    # if it does not, the gate is going too and its own purge deals with the file.
    if getent group bb-auth >/dev/null 2>&1; then
        # Both state files, not just the access file. This package's postinst took
        # ownership of both, so its purge has to hand both back, or the gate is left
        # reading a settings file owned by a user nothing runs as: `verify.sh` now asserts
        # exactly this on a gate-only host, which is how the omission became visible.
        for f in "$ACCESS_FILE" "$ACCESS_FILE.bak" "$SETTINGS_FILE" "$SETTINGS_FILE.bak"; do
            if [ -e "$f" ]; then
                chown root:bb-auth "$f"
                chmod 0640 "$f"
            fi
        done
        if [ -d "$VAR_DIR" ]; then
            chown root:root "$VAR_DIR"
            chmod 0755 "$VAR_DIR"
        fi
    fi
    ;;
esac

exit 0
