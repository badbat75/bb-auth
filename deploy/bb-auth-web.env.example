# bb-auth-web deployment configuration — TEMPLATE.
#
# The package installs this to <install-dir>/etc/bb-auth-web.env (0640, service-user
# readable) ONLY IF THERE IS NONE THERE, and never edits it afterwards: it is
# operator-owned, exactly like bb-auth.env. What an install does instead is VALIDATE it and
# abort before restarting anything, because a missing required var is a fatal startup and
# under Restart=on-failure that is a boot loop. So a first install of the GUI is two steps:
# install (which lands this file and stops), name an administrator on the host with
#   bb-auth-adm settings admin add you@example.com
# then install again.
#
# There is no secret in here. bb-auth-web validates no token, holds no HMAC key and mints
# no cookie — the only credential in the system stays in bb-auth.env.

# Where bb-auth-web listens. LOOPBACK ONLY, and that is not a preference: the whole trust
# model is that nothing reaches this port except through nginx, which gates it with
# bb-auth's own auth_request and injects the authorized email as X-Auth-Email. Exposed
# directly, anyone could name themselves an admin by sending that header.
BB_AUTH_WEB_LISTEN=127.0.0.1:8091

# The access file this GUI reads AND WRITES. Same variable name and same meaning as the
# gate's, on purpose: each service gets its own env file, and one name means one thing.
# It must be the file the gate actually loads, or the GUI edits a copy nothing serves —
# the install compares the two and refuses to restart if they disagree.
# The file is bb-auth-web:bb-auth 0640 once this GUI is installed (see the README): this
# service owns it, the gate reads it through the group, and `sudo bb-auth-adm` keeps
# working untouched because the writer preserves the owner it finds.
BB_AUTH_ACCESS_FILE=/opt/bb-auth/var/lib/access.json

# The administrator allowlist is NOT here: it is in the settings file (web.admins), where
# this service can edit it AND see the edit. That file is read fresh on every request, so
# naming a new administrator needs no restart, and the Settings tab can do it:
#
#   bb-auth-adm settings admin add you@example.com
#
# It is REQUIRED and never empty: bb-auth-web refuses to serve without one, and both editors
# refuse to write an empty list. Empty must never come to mean "everyone".
#
# Optional: where that file is. Default: settings.json beside BB_AUTH_ACCESS_FILE, which is
# what the package creates, and which must be the file the gate reads.
#BB_AUTH_SETTINGS_FILE=/opt/bb-auth/var/lib/settings.json

# URL prefix nginx mounts the GUI at. Empty = the root of its own vhost. It must match the
# nginx location, which passes the path through unchanged:
#   location /admin/ { ... proxy_pass http://127.0.0.1:8091; }   # NO URI part
# A proxy_pass with no URI part forwards the request path as-is, prefix included, which is
# why the GUI has to know the prefix: every href it emits carries it, and the router
# strips it. Leading/trailing slashes are normalised (`admin/` and `/admin` are the same).
BB_AUTH_WEB_BASE_PATH=/admin

# Interface language when the request expresses no preference at all: `en` or `it`. A
# ?lang= choice is remembered in a display-only cookie (no identity, no capability).
#BB_AUTH_WEB_DEFAULT_LANG=en

# Where the "Sign out" control in the header points. Unset = NO CONTROL AT ALL, which is the
# only safe default: this GUI speaks plain HTTP on loopback, so it knows neither its own
# scheme nor its own host, and the one thing it is handed is a client-supplied `Host:` —
# the very input the rest of this project refuses to let decide a redirect target. A button
# that signed an administrator out to an address an attacker picked would be a phishing
# gadget, so the address is yours to state.
#
# Normally the gate's own logout endpoint. Root-relative when the gate and this GUI are on
# one vhost (which needs no hostname at all), absolute https:// when they are not. With no
# `rd` on it, signing out lands on the login page and stops there.
#BB_AUTH_WEB_LOGOUT_URL=/auth/logout
#
# It MAY carry the gate's ?rd=, and that is how "sign out, then sign back in, and be where
# you were" is written: the gate clears the cookie and redirects there, that address is
# gated, so the 401 sends the browser to the login page carrying it, and the login hands it
# back. One value, the whole round trip:
#BB_AUTH_WEB_LOGOUT_URL=/auth/logout?rd=https%3A%2F%2Fauth.example.com%2Fadmin%2F
#
# The rd must be ABSOLUTE, and that is a consequence rather than a preference: the gate
# resolves a relative one against the caller origin it reads from BB_AUTH_ORIGINAL_URL_HEADER,
# and the logout location is deliberately ungated, so nginx has no reason to set that header
# there and normally does not. A relative rd then falls back to the login page, which is
# fail-soft and silent, and silent is the half that costs you an afternoon.
