# bb-auth deployment configuration — TEMPLATE.
#
# This is the file the package installs to <install-dir>/etc/bb-auth.env (0640,
# service-user readable) on a first install, with a freshly generated BB_AUTH_HMAC_KEY
# already in it: the secret only ever exists on the host. From then on the file is the
# operator's, filled in there and never rewritten by an install.
# A local copy for reference goes to `deploy/bb-auth.env` (gitignored); NEVER commit a
# filled-in one.

# Where bb-auth listens (the reverse proxy proxies to it). Loopback only.
BB_AUTH_LISTEN=127.0.0.1:4181

# Secret used to sign session cookies (HMAC-SHA256), >= 32 bytes.
# Leave EMPTY here: the package generates one on first install, and no later install
# can touch it, because no install ships this file. (By hand: openssl rand -base64 48)
BB_AUTH_HMAC_KEY=

# Key id stamped into new cookies (bb1.<keyid>.<exp>.<email>.<claims_json>.<sig>).
# Must match
# [A-Za-z0-9_-]+ (no '.'). Bump it when rotating BB_AUTH_HMAC_KEY so verify can
# still honour cookies signed under the previous key. See README "Key rotation".
BB_AUTH_HMAC_KEY_ID=default

# Optional: extra keys accepted for verification during rotation, as a comma-
# separated list of `id:key` (key = an `openssl rand -base64 48` string). Leave
# empty when there is only one key. Example for a k1->k2 rollover window:
#   BB_AUTH_HMAC_ACCEPTED_KEYS=k2:NEW_base64_key_here
BB_AUTH_HMAC_ACCEPTED_KEYS=

# Cognito user-pool issuer (JWKS URL is derived from this).
BB_AUTH_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>

# THE APP CLIENTS ARE NOT HERE. Which Cognito app clients this gate is part of is
# gate.client_id (the email flow's) and the audience of each gate.social_buttons entry, in
# the SETTINGS FILE. Together they are the accepted audiences: an id_token carries the app
# client it was minted for in `aud`, so naming one there is what makes its tokens acceptable
# here. The issuer above is what keeps that safe: the settings file chooses among the app
# clients of THIS pool and can never reach another one.
#
# THE HOT SETTINGS ARE NOT HERE EITHER, and deliberately: the sign-in page's URL, the whole
# social wiring, profile_claims, identity_attrs, allow_unverified_social, social_providers,
# session_ttl_secs, bb-auth-web's admins, and the whole `ui` section (how every page this
# binary serves looks). They live in settings.json beside the access file (see
# deploy/settings.example.json), because a process cannot re-read its own environment.
#
# Not for tidiness: a process cannot re-read its own environment. systemd loads this file
# once, at ExecStart, so nothing written here can ever take effect without a restart. Each of
# those is read per request, cannot lock anybody out when it is wrong, and holds no secret,
# which is exactly the rule that decides which file a setting belongs in.
#
# They are re-read on `systemctl reload bb-auth`, and are edited with
# `bb-auth-adm settings ...` or from bb-auth-web's Settings tab.
#
# Optional: where that file is. Default: settings.json beside BB_AUTH_ACCESS_FILE, which is
# what the package creates. A missing file is a fatal startup, like the access file's.
#BB_AUTH_SETTINGS_FILE=/opt/bb-auth/var/lib/settings.json

# Access file (JSON): the access gate — the applications, their scopes, and who may reach
# them. Re-checked on every /auth/validate; edit + `systemctl reload bb-auth` (SIGHUP) to
# apply live, or `systemctl restart bb-auth`.
# Validate before deploying: `bb-auth --check-access <file>`.
# Access is enumerated, never assumed: a URL no application covers is reachable by NOBODY,
# and a `restricted` scope that lists nobody admits nobody.
# Shape (see deploy/access.example.json and README "Access file"):
#   { "version": 1,
#     "applications": [
#       { "name": "mcp", "base": ["https://mcp.example.com/mcp"],
#         "scopes": [
#           { "name": "api", "urls": ["https://mcp.example.com/mcp/*"],
#             "access": "restricted", "users": ["<uuid>"],
#             "credentials": ["api_key"] } ] } ],
#     "users": [
#       { "uuid": "<uuid>", "emails": ["bot@example.com"],
#         "api_keys": [ { "id": "laptop",
#           "key_hash": "<sha256 of the bbk_ bearer>",        # from bb-auth-adm key add
#           "released": "2026-07-08", "duration": "365d",
#           "scopes": ["mcp/api"] } ] } ] }
BB_AUTH_ACCESS_FILE=/opt/bb-auth/var/lib/access.json

# Header carrying the ORIGINAL request URL — scheme, host and normalised path — on
# the nginx `auth_request` subrequest, used for per-user/per-key URL scoping.
# Default X-Original-URL. nginx must set it; hardcode the host per server block so a
# spoofed `Host:` header cannot widen a scope. Two steps, because inside the
# auth_request subrequest $uri is the subrequest's own URI (/internal/auth-gate):
#   location / {                  set $bb_url https://app.example.com$uri;
#                                 auth_request /internal/auth-gate; ... }
#   location = /internal/auth-gate { proxy_set_header X-Original-URL $bb_url; ... }
# Use $uri, not $request_uri: decoded, normalised, and free of the query string.
# The header is REQUIRED: every credential is scoped, so a request without it is
# denied (fail-closed) — including a gated location that forgot the `set`.
#BB_AUTH_ORIGINAL_URL_HEADER=X-Original-URL

# Session cookie. Its NAME and DOMAIN are here rather than in the settings file because
# changing either logs everybody out: the browser goes on presenting a cookie nothing reads
# any more. Its LIFETIME is in the settings file, because changing that affects only the
# cookies minted from then on.
BB_AUTH_COOKIE_NAME=bb_session
# Empty = host-only cookie (per-service login). Set to a parent domain
# (e.g. ".example.com") for cross-service SSO shared by every service behind the gate.
BB_AUTH_COOKIE_DOMAIN=

# Hosts the post-login redirect (`rd`) may land on — comma-separated glob patterns,
# matched against the host alone. REQUIRED: it is the only authority for the `rd`
# open-redirect guard. There is no "service base URL": one gate can front several
# hosts, and which one is in play is decided by the caller (nginx tells bb-auth via
# X-Original-URL on /auth/session, and a relative `rd` resolves against that host).
#
# Same wildcards a scope's urls use: `*` = any run of characters, `&` = exactly one.
# `*.example.com` does NOT match the bare apex — list it too if you want it.
# Cross-service SSO: list every sibling, and pair with BB_AUTH_COOKIE_DOMAIN=.example.com
# so the session cookie is shared. Per-service login: list only that one host.
# Read once at startup, so changes require `systemctl restart bb-auth` (not reload).
# Required: the package's preflight refuses to restart the service if this is missing.
BB_AUTH_AUTHORIZED_HOSTS=example.com,*.example.com

# The login page is gate.login_url in the SETTINGS FILE, and empty there means the gate's own
# /auth/login on whichever host the request arrived at. Whatever it names, nginx must leave
# /auth/login and /auth/callback UNGATED, exactly as it leaves /auth/session and /auth/logout:
# a sign-in page behind auth_request answers a signed-out visitor with itself, forever.

# ---------------------------------------------------------------------------
# Social sign-in: NOT HERE ANY MORE.
# ---------------------------------------------------------------------------
# The hosted-UI domain, the callback URL and one row per provider (its identity_provider and
# the app client that federates it) are gate.oauth_domain, gate.social_callback_url and
# gate.social_buttons in the settings file. Cognito federates PER APP CLIENT, which is why
# each button carries its own: two providers may perfectly well live on two of them, and one
# value for all of them could not say so.
#
#   bb-auth-adm settings set --oauth-domain <pool>.auth.<region>.amazoncognito.com \
#                            --social-callback-url https://auth.example.com/auth/callback \
#                            --social-buttons Google=<app-client>,MicrosoftPersonal=<app-client>

BB_AUTH_WORKERS=4
